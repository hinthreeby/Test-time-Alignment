{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reward-decoding.local/router_v2/router_training_config.schema.json",
  "title": "Router V2 Stage 5 training configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "router_kind",
    "router_config_path",
    "cache_root",
    "output_dir",
    "task",
    "seed",
    "device",
    "allow_cpu_fallback",
    "online_model_precision",
    "batch_size",
    "gradient_accumulation_steps",
    "num_epochs",
    "learning_rate",
    "weight_decay",
    "max_grad_norm",
    "entropy_weight",
    "smoothness_weight",
    "strength_weight",
    "selected_score_source",
    "preference_source",
    "same_average_baseline",
    "enforce_stage_order",
    "log_every_optimizer_steps",
    "checkpoint_every_optimizer_steps",
    "alpha_bins",
    "near_boundary_fraction",
    "max_train_samples",
    "max_validation_samples"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {"enum": ["taro", "state", "history", "alpha"]},
    "router_kind": {"enum": ["taro", "smart"]},
    "router_config_path": {"type": "string", "minLength": 1},
    "cache_root": {"type": "string", "minLength": 1},
    "output_dir": {"type": "string", "minLength": 1},
    "task": {"const": "sentiment"},
    "seed": {"type": "integer", "minimum": 0},
    "device": {"enum": ["auto", "cuda", "cpu"]},
    "allow_cpu_fallback": {"type": "boolean"},
    "online_model_precision": {"const": "fp32"},
    "batch_size": {"type": "integer", "minimum": 1},
    "gradient_accumulation_steps": {"type": "integer", "minimum": 1},
    "num_epochs": {"type": "integer", "minimum": 1},
    "learning_rate": {"type": "number", "exclusiveMinimum": 0},
    "weight_decay": {"type": "number", "minimum": 0},
    "max_grad_norm": {"type": "number", "exclusiveMinimum": 0},
    "entropy_weight": {"type": "number", "minimum": 0},
    "smoothness_weight": {"type": "number", "minimum": 0},
    "strength_weight": {"type": "number", "minimum": 0},
    "selected_score_source": {"const": "base_gold_logprob"},
    "preference_source": {"enum": ["none", "cache"]},
    "same_average_baseline": {"type": "boolean"},
    "enforce_stage_order": {"type": "boolean"},
    "log_every_optimizer_steps": {"type": "integer", "minimum": 1},
    "checkpoint_every_optimizer_steps": {"type": "integer", "minimum": 1},
    "alpha_bins": {"type": "integer", "minimum": 1},
    "near_boundary_fraction": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 0.5
    },
    "max_train_samples": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "max_validation_samples": {
      "type": ["integer", "null"],
      "minimum": 1
    }
  }
}
