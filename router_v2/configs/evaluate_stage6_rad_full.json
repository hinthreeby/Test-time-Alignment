{
  "schema_version": 1,
  "output_dir": "results/router_v2/rad/full",
  "dataset_dir": "dataset/rad_benchmark",
  "base_model_path": "models/gpt2-medium",
  "guide_model_path": "results/router_v2/sentiment_guide/final_adapter",
  "sentiment_classifier_path": "models/sentiment-roberta-large-english",
  "taro_checkpoint_path": "results/router_v2/training/taro/best.pt",
  "state_checkpoint_path": "results/router_v2/training/state/best.pt",
  "history_checkpoint_path": "results/router_v2/training/history/best.pt",
  "v1_results_dir": "router/evaluation/report_run_32tokens",
  "prompt_classes": ["negative", "neutral", "positive"],
  "validation_prompt_limit_per_class": 50,
  "test_prompt_limit_per_class": 200,
  "test_prompt_offset_per_class": 50,
  "seeds": [1],
  "fixed_lambda_sweep": [0.0, 0.25, 0.5, 0.75, 1.0],
  "heuristic_methods": ["heuristic_entropy_gap", "heuristic_js"],
