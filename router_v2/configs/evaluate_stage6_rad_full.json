  "top_k": 20,
  "temperature": 1.0,
  "do_sample": false,
  "stop_on_eos": false,
  "device": "auto",
  "allow_cpu_fallback": true,
  "precision": "fp32",
  "sentiment_classifier_device": "cpu",
  "sentiment_classifier_batch_size": 16,
  "bootstrap_samples": 1000,
  "bootstrap_seed": 12345,
  "log_every_jobs": 10
}
