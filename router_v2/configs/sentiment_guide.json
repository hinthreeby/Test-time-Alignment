{
  "schema_version": 1,
  "task": "sentiment",
  "objective": "positive_continuation_causal_nll",
  "base_model_path": "models/gpt2-medium",
  "train_data_path": "dataset/RAD_train/router_amazon_polarity/train.jsonl",
  "validation_data_path": "dataset/RAD_train/router_amazon_polarity/validation.jsonl",
  "negative_audit_data_path": "dataset/RAD_train/amazon_polarity/test/data-00000-of-00001.arrow",
  "output_dir": "results/router_v2/sentiment_guide",
  "seed": 42,
  "max_length": 160,
  "include_eos_target": true,
  "num_train_epochs": 1,
  "train_batch_size": 1,
  "eval_batch_size": 2,
  "gradient_accumulation_steps": 16,
  "learning_rate": 5e-05,
  "weight_decay": 0.0,
  "warmup_ratio": 0.03,
  "max_grad_norm": 1.0,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.05,
  "lora_target_modules": [
    "c_attn",
    "c_proj",
    "c_fc"
  ],
  "gradient_checkpointing": true,
  "precision": "fp16",
  "save_optimizer_steps": 250,
  "log_optimizer_steps": 10,
  "validation_positive_samples": 100,
  "validation_negative_samples": 100,
  "validation_inspection_samples": 20,
  "minimum_positive_nll_improvement": 0.01,
  "minimum_direction_delta_gap": 0.01,
  "cache_top_k": 20,
  "cache_max_position": 79,
  "cache_shard_size": 4096
}
