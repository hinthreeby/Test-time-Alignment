{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allow_cpu_fallback": {"type": "boolean"},
    "alpha_order": {
      "const": ["helpfulness", "harmlessness"]
    },
    "alpha_sampling": {"const": "uniform_simplex_hash"},
    "base_model_path": {"minLength": 1, "type": "string"},
    "bnb_4bit_quant_type": {"enum": ["nf4", "fp4"]},
    "bnb_4bit_use_double_quant": {"type": "boolean"},
    "checkpoint_every_optimizer_steps": {"minimum": 1, "type": "integer"},
    "cuda_memory_per_model_gib": {"minimum": 1, "type": "integer"},
    "data_root": {"minLength": 1, "type": "string"},
    "device": {"enum": ["auto", "cuda", "cpu"]},
    "enforce_stage_order": {"type": "boolean"},
    "gradient_accumulation_steps": {"minimum": 1, "type": "integer"},
    "include_eos_target": {"type": "boolean"},
    "learning_rate": {"exclusiveMinimum": 0, "type": "number"},
    "load_in_4bit": {"type": "boolean"},
    "log_every_optimizer_steps": {"minimum": 1, "type": "integer"},
    "max_continuation_tokens": {"minimum": 1, "type": "integer"},
    "max_grad_norm": {"exclusiveMinimum": 0, "type": "number"},
    "max_length": {"minimum": 2, "type": "integer"},
    "max_train_samples": {
      "anyOf": [{"minimum": 1, "type": "integer"}, {"type": "null"}]
    },
    "max_validation_samples": {
      "anyOf": [{"minimum": 1, "type": "integer"}, {"type": "null"}]
    },
    "method_label": {"const": "PARM_TARO_ROUTER_TRAINING"},
    "min_control_lambda_delta": {"exclusiveMinimum": 0, "type": "number"},
    "model_dtype": {"enum": ["float16", "bfloat16", "float32"]},
    "model_placement": {"enum": ["accelerate_auto", "single_device"]},
    "near_tie_threshold": {"maximum": 0.499999, "minimum": 0, "type": "number"},
    "num_epochs": {"minimum": 1, "type": "integer"},
    "output_dir": {"minLength": 1, "type": "string"},
    "parm_adapter_path": {"minLength": 1, "type": "string"},
    "require_shuffled_loss_degradation": {"type": "boolean"},
    "router_config_path": {"minLength": 1, "type": "string"},
    "router_kind": {"enum": ["taro", "smart"]},
    "scalarization_rule": {"const": "alpha_weighted_response_mean_nll"},
    "schema_version": {"const": 1},
    "seed": {"minimum": 0, "type": "integer"},
    "share_base_backbone": {"type": "boolean"},
    "stage": {"enum": ["taro", "v2_no_alpha", "v2_alpha"]},
    "static_reference_scale": {"minimum": 0, "type": "number"},
    "tokenizer_path": {"minLength": 1, "type": "string"},
    "validation_alpha_grid": {
      "items": {"maximum": 1, "minimum": 0, "type": "number"},
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "weight_decay": {"minimum": 0, "type": "number"}
  },
  "required": [
    "schema_version",
    "method_label",
    "stage",
    "router_kind",
    "router_config_path",
    "data_root",
    "base_model_path",
    "bnb_4bit_quant_type",
    "bnb_4bit_use_double_quant",
    "tokenizer_path",
    "parm_adapter_path",
    "output_dir",
    "seed",
    "device",
    "allow_cpu_fallback",
    "model_dtype",
    "model_placement",
    "share_base_backbone",
    "cuda_memory_per_model_gib",
    "max_length",
    "max_continuation_tokens",
    "include_eos_target",
    "num_epochs",
    "gradient_accumulation_steps",
    "learning_rate",
    "load_in_4bit",
    "weight_decay",
    "max_grad_norm",
    "alpha_sampling",
    "scalarization_rule",
    "alpha_order",
    "validation_alpha_grid",
    "near_tie_threshold",
    "static_reference_scale",
    "min_control_lambda_delta",
    "require_shuffled_loss_degradation",
    "enforce_stage_order",
    "log_every_optimizer_steps",
    "checkpoint_every_optimizer_steps",
    "max_train_samples",
    "max_validation_samples"
  ],
  "title": "PARM-TARO Stage 9 Router Training Configuration",
  "type": "object"
}
