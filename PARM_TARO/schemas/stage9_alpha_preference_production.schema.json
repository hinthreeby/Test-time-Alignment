{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allow_cpu_fallback": {"type": "boolean"},
    "base_training_config_path": {"minLength": 1, "type": "string"},
    "calibration_samples": {"minimum": 1, "type": "integer"},
    "checkpoint_every_optimizer_steps": {"minimum": 1, "type": "integer"},
    "device": {"enum": ["auto", "cuda", "cpu"]},
    "expected_train_samples": {"const": 8000},
    "expected_validation_samples": {"const": 500},
    "freeze_state_router_during_warmup": {"const": true},
    "gradient_accumulation_steps": {"minimum": 1, "type": "integer"},
    "learning_rate": {"exclusiveMinimum": 0, "type": "number"},
    "log_every_optimizer_steps": {"minimum": 1, "type": "integer"},
    "logit_sensitivity_gradient_target_ratio": {"minimum": 0, "type": "number"},
    "max_grad_norm": {"exclusiveMinimum": 0, "type": "number"},
    "max_logit_sensitivity_weight": {"exclusiveMinimum": 0, "type": "number"},
    "max_nll_degradation_vs_no_alpha": {"minimum": 0, "type": "number"},
    "max_nll_weight": {"minimum": 0, "type": "number"},
    "method_label": {"const": "PARM_TARO_ALPHA_PREFERENCE_PRODUCTION"},
    "min_control_lambda_delta": {"const": 0.001},
    "min_mean_lambda": {"minimum": 0, "type": "number"},
    "min_router_lambda_std": {"exclusiveMinimum": 0, "type": "number"},
    "nll_gradient_target_ratio": {"minimum": 0, "type": "number"},
    "no_alpha_checkpoint": {"minLength": 1, "type": "string"},
    "output_dir": {"const": "results/parm_taro/training/v2_alpha_preference"},
    "pilot_v2_checkpoint_path": {"minLength": 1, "type": "string"},
    "pilot_v2_report_path": {"minLength": 1, "type": "string"},
    "preference_weight": {"exclusiveMinimum": 0, "type": "number"},
    "quality_epochs": {"minimum": 1, "type": "integer"},
    "require_shuffled_preference_degradation": {"type": "boolean"},
    "required_alpha_path_diagnostic": {"minLength": 1, "type": "string"},
    "required_pilot_v3_checkpoint_path": {"minLength": 1, "type": "string"},
    "required_pilot_v3_report_path": {"minLength": 1, "type": "string"},
    "residual_hidden_dim": {"minimum": 1, "type": "integer"},
    "residual_output_weight_std": {"exclusiveMinimum": 0, "type": "number"},
    "schema_version": {"const": 1},
    "seed": {"minimum": 0, "type": "integer"},
    "strength_weight": {"minimum": 0, "type": "number"},
    "warmup_epochs": {"minimum": 1, "type": "integer"},
    "weight_decay": {"minimum": 0, "type": "number"}
  },
  "required": [
    "schema_version",
    "method_label",
    "base_training_config_path",
    "required_alpha_path_diagnostic",
    "required_pilot_v3_report_path",
    "required_pilot_v3_checkpoint_path",
    "pilot_v2_report_path",
    "pilot_v2_checkpoint_path",
    "no_alpha_checkpoint",
    "output_dir",
    "device",
    "allow_cpu_fallback",
    "seed",
    "expected_train_samples",
    "expected_validation_samples",
    "calibration_samples",
    "warmup_epochs",
    "quality_epochs",
    "gradient_accumulation_steps",
    "learning_rate",
    "weight_decay",
    "max_grad_norm",
    "residual_hidden_dim",
    "residual_output_weight_std",
    "preference_weight",
    "max_nll_weight",
    "nll_gradient_target_ratio",
    "strength_weight",
    "logit_sensitivity_gradient_target_ratio",
    "max_logit_sensitivity_weight",
    "freeze_state_router_during_warmup",
    "min_control_lambda_delta",
    "min_mean_lambda",
    "max_nll_degradation_vs_no_alpha",
    "require_shuffled_preference_degradation",
    "min_router_lambda_std",
    "log_every_optimizer_steps",
    "checkpoint_every_optimizer_steps"
  ],
  "title": "PARM-TARO Stage 9 Alpha-Preference Production Configuration",
  "type": "object"
}
