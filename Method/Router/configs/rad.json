{
  "lm_path": "models/gpt2-large",
  "rm_base_path": "models/gpt2-small",
  "rm_path": "models/rad_rm_sentiment",
  "top_k": 20,
  "max_response_tokens": 64,
  "max_new_tokens": 64,
  "seed": 42,

  "router": {
    "hidden_dim": 64,
    "output_min": 0.0,
    "output_max": 50.0
  },

  "training": {
    "epochs": 3,
    "lr": 0.0001,
    "weight_decay": 0.01
  },

  "router_data": {
    "dataset": "amazon_polarity",
    "split": "train",
    "text_field": "content",
    "label_field": "label",
    "label_value": 1,
    "num_train": 1000,
    "num_val": 200,
    "prompt_ratio": 0.35,
    "min_words": 8
  },

  "benchmark": {
    "dataset": "dataset/rad_benchmark/negative_prompts.jsonl",
    "num_prompts": 100
  }
}
