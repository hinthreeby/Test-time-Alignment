{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allow_cpu_fallback": {"type": "boolean"},
    "alpha_checkpoint": {"minLength": 1, "type": "string"},
    "base_training_config_path": {"minLength": 1, "type": "string"},
    "calibration_samples": {"minimum": 1, "type": "integer"},
    "device": {"enum": ["auto", "cuda", "cpu"]},
    "first_pilot_checkpoint_path": {"minLength": 1, "type": "string"},
    "first_pilot_report_path": {"minLength": 1, "type": "string"},
    "gradient_accumulation_steps": {"minimum": 1, "type": "integer"},
    "learning_rate": {"exclusiveMinimum": 0, "type": "number"},
    "log_every_optimizer_steps": {"minimum": 1, "type": "integer"},
    "max_grad_norm": {"exclusiveMinimum": 0, "type": "number"},
    "max_nll_degradation_vs_no_alpha": {"minimum": 0, "type": "number"},
    "max_nll_weight": {"minimum": 0, "type": "number"},
    "max_sensitivity_weight": {"exclusiveMinimum": 0, "type": "number"},
    "max_train_samples": {"minimum": 1, "type": "integer"},
    "max_validation_samples": {"minimum": 1, "type": "integer"},
    "method_label": {"const": "PARM_TARO_ALPHA_PREFERENCE_PILOT_V2"},
    "min_control_lambda_delta": {"const": 0.001},
    "min_mean_lambda": {"minimum": 0, "type": "number"},
    "nll_gradient_target_ratio": {"minimum": 0, "type": "number"},
    "no_alpha_checkpoint": {"minLength": 1, "type": "string"},
    "output_dir": {"minLength": 1, "type": "string"},
    "preference_weight": {"exclusiveMinimum": 0, "type": "number"},
    "quality_epochs": {"minimum": 1, "type": "integer"},
    "require_shuffled_preference_degradation": {"type": "boolean"},
    "required_failure_diagnostic_path": {"minLength": 1, "type": "string"},
    "schema_version": {"const": 1},
    "seed": {"minimum": 0, "type": "integer"},
    "sensitivity_gradient_target_ratio": {"minimum": 0, "type": "number"},
    "strength_weight": {"minimum": 0, "type": "number"},
    "warmup_epochs": {"minimum": 1, "type": "integer"},
    "weight_decay": {"minimum": 0, "type": "number"}
  },
  "required": [
    "schema_version",
    "method_label",
    "base_training_config_path",
    "required_failure_diagnostic_path",
    "first_pilot_report_path",
    "first_pilot_checkpoint_path",
    "alpha_checkpoint",
    "no_alpha_checkpoint",
    "output_dir",
    "device",
    "allow_cpu_fallback",
    "seed",
    "max_train_samples",
    "max_validation_samples",
    "calibration_samples",
    "warmup_epochs",
    "quality_epochs",
    "gradient_accumulation_steps",
    "learning_rate",
    "weight_decay",
    "max_grad_norm",
    "preference_weight",
    "max_nll_weight",
    "nll_gradient_target_ratio",
    "strength_weight",
    "sensitivity_gradient_target_ratio",
    "max_sensitivity_weight",
    "min_control_lambda_delta",
    "min_mean_lambda",
    "max_nll_degradation_vs_no_alpha",
    "require_shuffled_preference_degradation",
    "log_every_optimizer_steps"
  ],
  "title": "PARM-TARO Stage 9 Alpha-Preference Pilot V2 Configuration",
  "type": "object"
}
