{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allow_cpu_fallback": {"type": "boolean"},
    "base_training_config_path": {"minLength": 1, "type": "string"},
    "device": {"enum": ["auto", "cuda", "cpu"]},
    "gradient_accumulation_steps": {"minimum": 1, "type": "integer"},
    "initial_router_checkpoint": {"minLength": 1, "type": "string"},
    "learning_rate": {"exclusiveMinimum": 0, "type": "number"},
    "log_every_optimizer_steps": {"minimum": 1, "type": "integer"},
    "max_grad_norm": {"exclusiveMinimum": 0, "type": "number"},
    "max_nll_degradation_vs_no_alpha": {"minimum": 0, "type": "number"},
    "max_train_samples": {"minimum": 1, "type": "integer"},
    "max_validation_samples": {"minimum": 1, "type": "integer"},
    "method_label": {"const": "PARM_TARO_ALPHA_PREFERENCE_PILOT"},
    "min_control_lambda_delta": {"exclusiveMinimum": 0, "type": "number"},
    "min_mean_lambda": {"minimum": 0, "type": "number"},
    "nll_weight": {"exclusiveMinimum": 0, "type": "number"},
    "no_alpha_checkpoint": {"minLength": 1, "type": "string"},
    "num_epochs": {"minimum": 1, "type": "integer"},
    "output_dir": {"minLength": 1, "type": "string"},
    "pairwise_logit_scale": {"exclusiveMinimum": 0, "type": "number"},
    "preference_loss_weight": {"exclusiveMinimum": 0, "type": "number"},
    "require_shuffled_preference_degradation": {"type": "boolean"},
    "required_diagnostic_path": {"minLength": 1, "type": "string"},
    "schema_version": {"const": 1},
    "seed": {"minimum": 0, "type": "integer"},
    "strength_target": {"minimum": 0, "type": "number"},
    "strength_weight": {"minimum": 0, "type": "number"},
    "weight_decay": {"minimum": 0, "type": "number"}
  },
  "required": [
    "schema_version",
    "method_label",
    "base_training_config_path",
    "required_diagnostic_path",
    "initial_router_checkpoint",
    "no_alpha_checkpoint",
    "output_dir",
    "device",
    "allow_cpu_fallback",
    "seed",
    "max_train_samples",
    "max_validation_samples",
    "num_epochs",
    "gradient_accumulation_steps",
    "learning_rate",
    "weight_decay",
    "max_grad_norm",
    "preference_loss_weight",
    "nll_weight",
    "strength_weight",
    "strength_target",
    "pairwise_logit_scale",
    "min_mean_lambda",
    "min_control_lambda_delta",
    "max_nll_degradation_vs_no_alpha",
    "require_shuffled_preference_degradation",
    "log_every_optimizer_steps"
  ],
  "title": "PARM-TARO Stage 9 Alpha-Preference Pilot Configuration",
  "type": "object"
}
