{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allow_cpu_fallback": {"type": "boolean"},
    "base_model_path": {"minLength": 1, "type": "string"},
    "device": {"enum": ["auto", "cuda", "cpu"]},
    "do_sample": {"type": "boolean"},
    "guide_vocab_policy": {"const": "base_tokenizer_prefix"},
    "max_new_tokens": {"minimum": 1, "type": "integer"},
    "method_label": {"const": "PARM_TARO"},
    "model_dtype": {"enum": ["float16", "bfloat16", "float32"]},
    "parm_adapter_path": {"minLength": 1, "type": "string"},
    "preference": {
      "items": {"minimum": 0, "type": "number"},
      "minItems": 1,
      "type": "array"
    },
    "preference_dim": {"minimum": 1, "type": "integer"},
    "router_checkpoint_path": {"minLength": 1, "type": "string"},
    "router_tokenizer_semantic_sha256": {"minLength": 1, "type": "string"},
    "schema_version": {"const": 1},
    "seed": {"type": "integer"},
    "static_reference_scale": {"minimum": 0, "type": "number"},
    "stop_on_eos": {"type": "boolean"},
    "temperature": {"exclusiveMinimum": 0, "type": "number"},
    "tokenizer_path": {"minLength": 1, "type": "string"},
    "top_k": {"minimum": 1, "type": "integer"}
  },
  "required": [
    "allow_cpu_fallback",
    "base_model_path",
    "device",
    "do_sample",
    "guide_vocab_policy",
    "max_new_tokens",
    "method_label",
    "model_dtype",
    "parm_adapter_path",
    "preference",
    "preference_dim",
    "router_checkpoint_path",
    "router_tokenizer_semantic_sha256",
    "schema_version",
    "seed",
    "static_reference_scale",
    "stop_on_eos",
    "temperature",
    "tokenizer_path",
    "top_k"
  ],
  "title": "PARM-TARO inference config",
  "type": "object"
}
