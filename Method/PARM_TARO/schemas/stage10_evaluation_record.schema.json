{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PARM-TARO Stage 10 generation record",
  "type": "object",
  "required": [
    "schema_version", "phase", "prompt_id", "source_index", "prompt",
    "alpha_index", "requested_alpha", "guide_alpha", "method", "seed",
    "generated_text", "selected_token_ids", "lambda_history",
    "base_conditional_perplexity", "latency_seconds"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "phase": {"enum": ["smoke", "full"]},
    "prompt_id": {"type": "string", "minLength": 1},
    "method": {
      "enum": [
        "parm_static", "parm_taro", "parm_v2_no_alpha",
        "parm_v2_full_alpha", "parm_v2_full_alpha_same_average",
        "parm_v2_full_alpha_shuffled_alpha",
        "parm_v2_full_alpha_fixed_alpha"
      ]
    },
    "requested_alpha": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "guide_alpha": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "selected_token_ids": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
    "lambda_history": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "base_conditional_perplexity": {"type": "number", "exclusiveMinimum": 0},
    "latency_seconds": {"type": "number", "minimum": 0}
  },
  "additionalProperties": true
}
