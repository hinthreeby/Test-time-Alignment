{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reward-decoding.local/router_v2/rad_evaluation_config.schema.json",
  "title": "Router V2 Stage 6 RAD evaluation configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "output_dir", "dataset_dir", "base_model_path",
    "guide_model_path", "sentiment_classifier_path", "taro_checkpoint_path",
    "state_checkpoint_path", "history_checkpoint_path", "v1_results_dir",
    "prompt_classes", "validation_prompt_limit_per_class",
    "test_prompt_limit_per_class", "test_prompt_offset_per_class", "seeds",
    "fixed_lambda_sweep", "heuristic_methods", "max_new_tokens", "top_k",
    "temperature", "do_sample", "stop_on_eos", "device",
    "allow_cpu_fallback", "precision", "sentiment_classifier_device",
    "sentiment_classifier_batch_size",
    "bootstrap_samples", "bootstrap_seed", "log_every_jobs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "output_dir": {"type": "string", "pattern": "^results/router_v2/rad/"},
    "dataset_dir": {"type": "string", "minLength": 1},
    "base_model_path": {"type": "string", "minLength": 1},
    "guide_model_path": {"type": "string", "minLength": 1},
    "sentiment_classifier_path": {"type": "string", "minLength": 1},
    "taro_checkpoint_path": {"type": "string", "minLength": 1},
    "state_checkpoint_path": {"type": "string", "minLength": 1},
    "history_checkpoint_path": {"type": "string", "minLength": 1},
    "v1_results_dir": {"type": "string", "minLength": 1},
    "prompt_classes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["negative", "neutral", "positive"]}
    },
    "validation_prompt_limit_per_class": {"type": "integer", "minimum": 1},
    "test_prompt_limit_per_class": {"type": "integer", "minimum": 1},
    "test_prompt_offset_per_class": {"type": "integer", "minimum": 0},
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "fixed_lambda_sweep": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "heuristic_methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["heuristic_entropy_gap", "heuristic_js"]}},
    "max_new_tokens": {"type": "integer", "minimum": 32, "maximum": 80},
    "top_k": {"const": 20},
    "temperature": {"type": "number", "exclusiveMinimum": 0},
    "do_sample": {"type": "boolean"},
    "stop_on_eos": {"type": "boolean"},
    "device": {"enum": ["auto", "cuda", "cpu"]},
    "allow_cpu_fallback": {"type": "boolean"},
    "precision": {"const": "fp32"},
    "sentiment_classifier_device": {"enum": ["auto", "cuda", "cpu"]},
    "sentiment_classifier_batch_size": {"type": "integer", "minimum": 1},
    "bootstrap_samples": {"type": "integer", "minimum": 1},
    "bootstrap_seed": {"type": "integer", "minimum": 0},
    "log_every_jobs": {"type": "integer", "minimum": 1}
  }
}
