# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.env
.env.*
.venv/
venv/
env/
conda-env/
*.egg-info/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# Logs and temporary files
*.log
*.tmp
*.temp
tmp/
temp/
.cache/
cache/

# The historical Router V2 Python cache package was accidentally hidden by
# the generic cache/ rule.  Track source only; generated cache payloads stay
# ignored.
!router_v2/cache/
router_v2/cache/*
!router_v2/cache/*.py

# Hugging Face / PyTorch caches
**/.cache/huggingface/
**/.cache/torch/
huggingface/
wandb/
runs/

# Large local models and checkpoints
models/
checkpoints/
**/checkpoints/
**/saved_models/
*.bin
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx

# Generated experiment outputs
results/*.json
results/*.jsonl
results/*.csv
results/*.png
results/*.pdf

# Keep documentation/placeholders inside ignored directories
!results/.gitkeep
!results/README.md
!models/README.md
!Method/CD/models/
!Method/CD/models/*.py
!Method/MultiSignal/models/
!Method/MultiSignal/models/*.py

# Dataset artifacts that are commonly large
dataset/**/*.zip
dataset/**/*.tar
dataset/**/*.tar.gz
dataset/**/*.parquet
dataset/**/*.arrow

# Local secrets
*.pem
*.key
token.txt
credentials.json
evaluation/report_run_32tokens/per_sample_metrics.csv
evaluation/report_run_32tokens/per_sample_outputs.jsonl

# Generated experiment outputs - recursive
results/**/*.json
results/**/*.jsonl
results/**/*.csv
results/**/*.png
results/**/*.pdf

# Router evaluation large outputs
router/evaluation/**/per_sample_metrics.csv
router/evaluation/**/per_sample_outputs.jsonl
